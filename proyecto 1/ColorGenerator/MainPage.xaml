<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ColorGenerator.MainPage">

    <Grid x:Name="MainContainer" BackgroundColor="#FFFFFF">
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center" HorizontalOptions="Center">

            <!-- Hex Display & Copy -->
            <Border BackgroundColor="#A0000000" StrokeShape="RoundRectangle 15" Padding="20" StrokeThickness="0">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label x:Name="HexLabel" 
                           Text="#FFFFFF" 
                           TextColor="White"
                           FontSize="32" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    
                    <Button Text="Copiar Hexadecimal" 
                            Clicked="OnCopyClicked" 
                            BackgroundColor="#33000000" 
                            TextColor="White" 
                            FontSize="16" 
                            CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Manual Controls -->
            <Border BackgroundColor="#A0000000" StrokeShape="RoundRectangle 15" Padding="20" StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Generador Manual" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Label Text="Rojo" TextColor="White" />
                    <Slider x:Name="SliderRed" Minimum="0" Maximum="255" Value="240" ValueChanged="OnSliderValueChanged" MinimumTrackColor="#FF5252" />

                    <Label Text="Verde" TextColor="White" />
                    <Slider x:Name="SliderGreen" Minimum="0" Maximum="255" Value="240" ValueChanged="OnSliderValueChanged" MinimumTrackColor="#4CAF50" />

                    <Label Text="Azul" TextColor="White" />
                    <Slider x:Name="SliderBlue" Minimum="0" Maximum="255" Value="240" ValueChanged="OnSliderValueChanged" MinimumTrackColor="#2196F3" />
                    
                    <Button x:Name="RandomButton"
                            Text="Generar Aleatorio"
                            Clicked="OnRandomClicked"
                            BackgroundColor="#F0F0F0"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="50"
                            Margin="0,15,0,0" />
                </VerticalStackLayout>
            </Border>
            
        </VerticalStackLayout>
    </Grid>

</ContentPage>
